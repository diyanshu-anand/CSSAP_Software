{
  "name": "abm-frontend",
  "version": "0.1.31",
  "private": true,
  "main": "electron/main.js",
  "description": "ABM School ERP System",
  "author": "Divyanshu Anand",
  "homepage": "./",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "axios": "^1.14.0",
    "chart.js": "^4.5.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "file-saver": "^2.0.5",
    "html2pdf.js": "^0.14.0",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "sqlite3": "^6.0.1",
    "uuid": "^13.0.0",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"npm run electron\"",
    "build-react": "react-scripts build",
    "build": "npm run build-react && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.abm.school",
    "productName": "ABM School ERP",
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://lightblue-wolverine-671984.hostingersite.com/updates/"
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
